# Server
PORT=4000
CORS_ORIGINS=http://localhost:5170,http://localhost:5171,http://localhost:5172,http://localhost:5173

# Firebase Admin (service-account JSON, single-line escaped)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Admin allowlist (comma-separated emails). These accounts get admin access in /admin.
ADMIN_EMAILS=

# Detection bridge (optional shared secret for the camera client)
DETECTION_TOKEN=

# Cloudinary (media uploads — required in prod, optional in local dev)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
